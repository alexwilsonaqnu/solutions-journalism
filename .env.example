# Copy to .env for local development. In Fly, set these with `fly secrets set` (never commit real values).
# Non-secret settings (APP_ENV, DRY_RUN, schedule) live in fly.toml [env].

APP_ENV=dev
DRY_RUN=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/solbrief

# Admin API bearer token (long random string). Unset = admin API disabled.
ADMIN_TOKEN=
# Signs one-click feedback / unsubscribe links (M5).
HMAC_SECRET=
# Where the "run not complete by deadline" alert goes.
ALERT_EMAIL=

SCHEDULE_TIMEZONE=America/Chicago
DAILY_RUN_TIME=04:30
RUN_DEADLINE=06:30

# --- Model providers
# Optional for M2: enables the LLM classification fallback (required from M3).
ANTHROPIC_API_KEY=
CLASSIFIER_MODEL=claude-haiku-5-5
VOYAGE_API_KEY=

# --- Postmark (outbound + inbound webhook)
POSTMARK_SERVER_TOKEN=
POSTMARK_INBOUND_WEBHOOK_SECRET=
POSTMARK_FROM=briefing@example.org
POSTMARK_BROADCAST_STREAM=broadcast
POSTMARK_TRANSACTIONAL_STREAM=outbound

# --- Observability: Pydantic Logfire (OpenTelemetry). Unset = spans created but not exported.
LOGFIRE_TOKEN=

# --- Source API keys (register under an institutional Knight Lab address)
OPENALEX_API_KEY=
BLS_API_KEY=
CENSUS_API_KEY=
EIA_API_KEY=
NWS_USER_AGENT=solbrief (Knight Lab, Northwestern University)
